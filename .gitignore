*.pyc

# Chat exports — commit only the extracted .md, not the bulky HTML and asset bundles
chats/*.html
chats/*_files/
chats/*-raw.md

# Fine-tune track — heavy/derived artifacts (corpus, JSONL, adapters, base cache)
training/finetune/data/
training/finetune/adapters/
training/finetune/logs/
